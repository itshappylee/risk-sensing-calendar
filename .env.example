# Supabase connection template
#
# Copy this to .env.local and fill in the values.
# .env.local is git-ignored (*.local) — never commit it.
#
#   cp .env.example .env.local
#
# ⚠️ Only put the anon / publishable key here. Never the service_role key.
#    service_role bypasses Row Level Security entirely, and anything here
#    ends up visible in the browser bundle.
#
# Find these in the Supabase dashboard → Project Settings → API:
#   Project URL         → VITE_SUPABASE_URL
#   anon / publishable   → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
