{
  "name": "risk-sensing-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:calendar": "npx esbuild scripts/check-calendar.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check.mjs --log-level=warning && node node_modules/.cache/check.mjs",
    "check:batch": "npx esbuild scripts/check-batch.ts --bundle --platform=node --format=esm --external:exceljs '--define:import.meta.env={}' --outfile=node_modules/.cache/check-batch.mjs --log-level=warning && node node_modules/.cache/check-batch.mjs",
    "check:routecsv": "npx esbuild scripts/check-routecsv.ts --bundle --platform=node --format=esm '--define:import.meta.env={}' --outfile=node_modules/.cache/check-routecsv.mjs --log-level=warning && node node_modules/.cache/check-routecsv.mjs",
    "check:allpairs": "npx esbuild scripts/check-allpairs.ts --bundle --platform=node --format=esm '--define:import.meta.env={}' --outfile=node_modules/.cache/check-allpairs.mjs --log-level=warning && node node_modules/.cache/check-allpairs.mjs",
    "check:graph": "npx esbuild scripts/check-graph.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-graph.mjs --log-level=warning && node node_modules/.cache/check-graph.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "d3-geo": "^3.1.1",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
